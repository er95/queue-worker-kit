# Copy to .env and adjust. Every variable here is optional: the defaults shown
# are the ones the application already uses, and every value is validated at
# boot, so a malformed entry fails the process rather than becoming a surprise
# default. See docs/operations.md for how to choose them.
#
#   cp .env.example .env

# development | test | production
NODE_ENV=development

# --- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# --- Redis ------------------------------------------------------------------
# Must be a redis:// or rediss:// (TLS) URL. Inside Docker Compose this is
# redis://redis:6379: `localhost` there refers to the container itself.
REDIS_URL=redis://localhost:6379

# --- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug
# Human-readable logs via pino-pretty. Defaults to on outside production, and
# is ignored in the production image, where pino-pretty is not installed.
# LOG_PRETTY=true

# --- Queues -----------------------------------------------------------------
# Namespaces every Redis key, so one Redis instance can host several
# environments without them seeing each other's jobs.
QUEUE_PREFIX=qwk

# --- Worker -----------------------------------------------------------------
# Jobs processed in parallel PER WORKER PROCESS, not per cluster. Three replicas
# at 10 gives up to 30 concurrent jobs. Suits I/O-bound work; CPU-bound jobs
# will block the event loop instead (see docs/reliability.md).
WORKER_CONCURRENCY=10

# --- Retries ----------------------------------------------------------------
# Total attempts, including the first. BullMQ's exponential backoff means
# 5 attempts at 2000ms waits 2s, 4s, 8s, 16s between them.
JOB_ATTEMPTS=5
JOB_BACKOFF_DELAY_MS=2000

# --- Retention --------------------------------------------------------------
# Finished jobs kept per queue. Unbounded retention is the most common way a
# BullMQ deployment runs its Redis out of memory.
JOB_REMOVE_ON_COMPLETE_COUNT=1000
JOB_REMOVE_ON_FAIL_COUNT=5000

# Dead-letter records are never consumed, so `removeOnFail` retention does not
# apply to them. Oldest records are evicted past this count.
DEAD_LETTER_MAX_ENTRIES=5000

# --- Rate limiting ----------------------------------------------------------
# Also per worker process: 100 jobs / 1000ms each. Use
# queue.setGlobalRateLimit() for a cluster-wide ceiling.
WORKER_RATE_LIMIT_MAX=100
WORKER_RATE_LIMIT_DURATION_MS=1000

# --- Timeouts ---------------------------------------------------------------
# Deadline for a single attempt. Cooperative: the job's AbortSignal fires and
# the attempt fails, but Node cannot forcibly stop work that ignores the signal.
JOB_TIMEOUT_MS=30000

# Hard ceiling on graceful shutdown. Keep the orchestrator's grace period
# (Compose stop_grace_period, Kubernetes terminationGracePeriodSeconds) above
# this, or SIGKILL will arrive first.
SHUTDOWN_TIMEOUT_MS=30000

# --- Scheduling -------------------------------------------------------------
# Worker processes upsert the recurring schedules on boot. Safe from every
# replica: the scheduler id is deterministic and the operation is an upsert.
ENABLE_JOB_SCHEDULERS=true
# 5- or 6-field cron. Default: hourly, on the hour.
MAINTENANCE_CLEANUP_CRON=0 * * * *

# Queue-wide lifecycle logging via BullMQ QueueEvents. Costs one extra Redis
# connection per queue per worker process.
ENABLE_QUEUE_EVENTS=true

# --- Worker metrics endpoint ------------------------------------------------
# The worker process serves /metrics and /health/live on its own port. Job
# lifecycle counters (started, completed, failed, dead-lettered) are recorded
# where the jobs run, so without this they cannot be scraped at all. It cannot
# enqueue and exposes no queue operations, but keep it on an internal port.
ENABLE_WORKER_METRICS_SERVER=true
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9090

# --- Bull Board dashboard ---------------------------------------------------
# Off by default, and it is a privileged control surface: it can retry, remove
# and drain queues, so it is never served anonymously.
#
# docker-compose.yml reads these same variables, so setting them here is what
# enables the dashboard for the Compose stack too.
ENABLE_BULL_BOARD=false

# Required once the dashboard is on. The value below is fine for a laptop but
# is rejected under NODE_ENV=production, where the password must be at least
# 16 characters and not a well-known example. Basic auth still sends the
# password in the clear, so put the dashboard behind TLS and, ideally, an
# authenticated proxy.
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change-me
