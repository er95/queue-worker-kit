{
  "name": "queue-worker-kit",
  "version": "0.1.0",
  "description": "Production-ready BullMQ worker starter with retries, observability, graceful shutdown, rate limiting, scheduling, dead-letter handling and Docker support",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.1.0",
  "keywords": [
    "bullmq",
    "redis",
    "queue",
    "worker",
    "background-jobs",
    "typescript",
    "nodejs",
    "jobs",
    "task-queue",
    "distributed-systems"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/er95/queue-worker-kit.git"
  },
  "bugs": {
    "url": "https://github.com/er95/queue-worker-kit/issues"
  },
  "homepage": "https://github.com/er95/queue-worker-kit#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/server.ts",
    "build": "tsc --build tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/api/server.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "dependencies": {
    "@bull-board/api": "9.6.0",
    "@bull-board/fastify": "9.6.0",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/helmet": "13.1.1",
    "bullmq": "6.3.2",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
